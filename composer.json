{
  "name": "fitlife/api",
  "description": "Backend base en PHP con conexión MySQL mediante PDO",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "David Asaaf Vergara Almanza",
      "email": "davida.vergaraa@autonoma.edu.co"
    }
